---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Icon from "../../components/Icon.astro";
---

<AdminLayout title="Staff Login">
  <main class="min-h-screen flex items-center justify-center px-5">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex flex-col items-center gap-3" aria-label="Mory's — public site">
          <img src="/morys_logo.png" alt="" width="64" height="64" class="w-16 h-16 object-contain" />
          <span class="font-condensed font-bold uppercase text-3xl tracking-[0.04em]">Mory's</span>
          <span class="text-[0.62rem] uppercase tracking-[0.28em] text-brand-yellow font-bold">Staff Dashboard</span>
        </a>
      </div>

      <form id="pin-form" class="bg-white/[0.04] border border-white/15 p-7">
        <label for="pin" class="block text-[0.7rem] uppercase tracking-[0.18em] text-white/70 font-bold mb-3">
          Enter your PIN
        </label>
        <input
          id="pin"
          name="pin"
          type="password"
          inputmode="numeric"
          autocomplete="off"
          autofocus
          required
          class="w-full bg-brand-navy-700 border border-white/20 px-4 py-3 text-white text-center text-2xl tracking-[0.5em] placeholder:text-white/25 focus:outline-none focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/30"
          placeholder="••••"
        />

        <button
          type="submit"
          id="pin-submit"
          class="mt-5 w-full inline-flex items-center justify-center gap-2 bg-brand-yellow text-brand-navy font-bold uppercase tracking-wide px-6 py-3.5 hover:bg-white transition-colors disabled:opacity-60"
        >
          <span class="pin-label inline-flex items-center gap-2">
            Unlock
            <Icon name="arrow-right" size={18} strokeWidth={2.25} />
          </span>
          <span class="pin-spinner hidden">Checking…</span>
        </button>

        <p id="pin-error" class="hidden mt-4 text-sm text-center text-brand-yellow font-semibold"></p>
      </form>

      <p class="mt-6 text-center text-xs text-white/40">
        Authorized staff only. <a href="/" class="underline hover:text-white/70">Back to site</a>
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById("pin-form") as HTMLFormElement;
    const btn = document.getElementById("pin-submit") as HTMLButtonElement;
    const label = form.querySelector(".pin-label") as HTMLElement;
    const spinner = form.querySelector(".pin-spinner") as HTMLElement;
    const errEl = document.getElementById("pin-error")!;
    const pinInput = document.getElementById("pin") as HTMLInputElement;

    const setLoading = (v: boolean) => {
      btn.disabled = v;
      label.classList.toggle("hidden", v);
      spinner.classList.toggle("hidden", !v);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.classList.add("hidden");
      setLoading(true);
      try {
        const res = await fetch("/api/staff/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pin: pinInput.value }),
        });
        if (res.ok) {
          window.location.href = "/admin";
          return;
        }
        const body = await res.json().catch(() => ({}));
        errEl.textContent = body.error || "Incorrect PIN.";
        errEl.classList.remove("hidden");
        pinInput.value = "";
        pinInput.focus();
      } catch {
        errEl.textContent = "Network error. Try again.";
        errEl.classList.remove("hidden");
      } finally {
        setLoading(false);
      }
    });
  </script>
</AdminLayout>
