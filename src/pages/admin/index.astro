---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Icon from "../../components/Icon.astro";

// Placeholder dashboard tiles. The actual tools (leads inbox, P&L) come later.
const tiles = [
  { title: "Leads", desc: "Incoming part requests from the website.", icon: "mail", href: "/admin/leads", status: "Open" },
  { title: "Profit & Loss", desc: "Weekly P&L entry + history (shop + eBay).", icon: "gauge", href: null, status: "Coming soon" },
  { title: "Inventory notes", desc: "Quick reference and supplier contacts.", icon: "package", href: null, status: "Coming soon" },
];
---

<AdminLayout title="Dashboard">
  <header class="border-b border-white/10">
    <div class="mx-auto max-w-5xl px-5 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="font-condensed font-bold uppercase text-2xl tracking-[0.04em]">Mory's</span>
        <span class="text-[0.62rem] uppercase tracking-[0.24em] text-brand-yellow font-bold">Staff</span>
      </div>
      <button
        id="logout"
        class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-white/70 hover:text-brand-yellow transition-colors"
      >
        Log out
        <Icon name="arrow-up-right" size={15} strokeWidth={2.25} />
      </button>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-5 lg:px-8 py-12">
    <p class="text-[0.7rem] font-bold uppercase tracking-[0.3em] text-brand-yellow">Dashboard</p>
    <h1 class="mt-3 font-condensed font-bold uppercase text-4xl sm:text-5xl">Welcome back.</h1>
    <p class="mt-3 text-white/70 max-w-xl">
      This is the staff area. Tools below are placeholders for now — we'll wire them up next.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {tiles.map((t) => {
        const Tag = t.href ? "a" : "div";
        return (
          <Tag
            href={t.href}
            class:list={[
              "border border-white/15 bg-white/[0.03] p-6 block",
              t.href ? "hover:border-brand-yellow hover:bg-white/[0.06] transition-colors" : "opacity-80",
            ]}
          >
            <div class="w-11 h-11 bg-brand-yellow text-brand-navy flex items-center justify-center mb-4">
              <Icon name={t.icon} size={22} strokeWidth={2} />
            </div>
            <h2 class="font-condensed font-bold uppercase text-xl tracking-wide">{t.title}</h2>
            <p class="mt-2 text-sm text-white/65 leading-relaxed">{t.desc}</p>
            <span
              class:list={[
                "mt-4 inline-block text-[0.65rem] uppercase tracking-[0.2em] border px-2 py-1",
                t.href ? "text-brand-yellow border-brand-yellow/40" : "text-white/40 border-white/15",
              ]}
            >
              {t.status}
            </span>
          </Tag>
        );
      })}
    </div>
  </main>

  <script>
    document.getElementById("logout")?.addEventListener("click", async () => {
      await fetch("/api/staff/logout", { method: "POST" }).catch(() => {});
      window.location.href = "/admin/login";
    });
  </script>
</AdminLayout>
