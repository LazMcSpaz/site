---
interface Props {
  label: string;
  ratio: string; // e.g. "16/9", "4/3", "1/1", "21/9"
  recommended?: string; // e.g. "1920×1080 JPG"
  class?: string;
}

const { label, ratio, recommended, class: className = "" } = Astro.props;
---

<div
  class={`photo-placeholder rounded-sm w-full ${className}`}
  style={`aspect-ratio: ${ratio};`}
  aria-label={`Placeholder: ${label}`}
>
  <div class="flex flex-col items-center gap-1 px-4">
    <span class="text-[0.7rem] tracking-[0.18em] opacity-70">PHOTO</span>
    <span class="font-semibold text-sm tracking-wide text-brand-black/80">
      {label}
    </span>
    <span class="text-[0.7rem] tracking-[0.12em] opacity-60">
      {ratio.replace("/", ":")}{recommended ? ` · ${recommended}` : ""}
    </span>
  </div>
</div>
