---
// Inline Tabler icons. We curate a small set of names → SVG paths so we can
// reference icons by semantic name in templates without shipping the full set.
//
// To add more, copy the inner <path>/<line>/<circle> elements from
// tabler-icons-3.41.1/icons/outline/<name>.svg into the ICONS map below.

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.75, class: className = "" } = Astro.props;

const ICONS: Record<string, string> = {
  // Navigation / actions
  phone: `<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />`,
  mail: `<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" />`,
  "map-pin": `<path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />`,
  clock: `<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 7v5l3 3" />`,
  search: `<path d="M3 10a7 7 0 1 0 14 0a7 7 0 0 0 -14 0" /><path d="M21 21l-6 -6" />`,
  tag: `<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" /><path d="M7.5 9.5l.01 0" />`,
  truck: `<path d="M7 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M17 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M5 17h-2v-11a1 1 0 0 1 1 -1h9v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5" />`,
  car: `<path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5" />`,
  // Categories
  package: `<path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5" /><path d="M12 12l8 -4.5" /><path d="M12 12l0 9" /><path d="M12 12l-8 -4.5" /><path d="M16 5.25l-8 4.5" />`,
  recycle: `<path d="M12 17l-2 2l2 2" /><path d="M10 19h9a2 2 0 0 0 1.75 -2.75l-.55 -1" /><path d="M8.536 11l-.732 -2.732" /><path d="M16.732 13.732l-1.732 -3l-2.732 .732" /><path d="M7.804 8.268l-3 .732l.732 2.732" /><path d="M5 11l-1.45 2.71a2 2 0 0 0 1.75 2.29h1" /><path d="M15.464 11l1.732 -3l-2.732 -.732" /><path d="M17.196 8l1.043 -1.808a2 2 0 0 0 -1.6 -2.992h-1.139" /><path d="M14 4l-2 -2l-2 2" /><path d="M12 2v8" />`,
  wrench: `<path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />`,
  window: `<path d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" /><path d="M3 12h18" /><path d="M12 3v18" />`,
  // Other
  "arrow-right": `<path d="M5 12l14 0" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" />`,
  "arrow-up-right": `<path d="M17 7l-10 10" /><path d="M8 7l9 0l0 9" />`,
  star: `<path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z" />`,
  check: `<path d="M5 12l5 5l10 -10" />`,
  menu: `<path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />`,
  x: `<path d="M18 6l-12 12" /><path d="M6 6l12 12" />`,
  chevron: `<path d="M9 6l6 6l-6 6" />`,
  "external-link": `<path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" />`,
  gauge: `<path d="M19.071 4.929a10 10 0 1 0 0 14.142m0 -14.142a10 10 0 0 1 0 14.142m0 -14.142l-9.071 9.071" /><path d="M13 13m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />`,
  shield: `<path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />`,
  tools: `<path d="M3 21h4l13 -13a1.5 1.5 0 0 0 -4 -4l-13 13v4" /><path d="M14.5 5.5l4 4" /><path d="M12 8l-5 -5l-4 4l5 5" /><path d="M7 8l-1.5 1.5" /><path d="M16 12l5 5l-4 4l-5 -5" /><path d="M16 17l-1.5 1.5" />`,
};

const path = ICONS[name];
if (!path) {
  console.warn(`<Icon name="${name}" /> — no icon registered. Add it to src/components/Icon.astro.`);
}
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={path ?? ""}
/>
