---
import ServiceMap from "../../ServiceMap.astro";
import Icon from "../../Icon.astro";
import { serviceCities } from "../../../data/content.ts";
---

<section class="bg-brand-cream py-20 lg:py-28 border-b border-brand-navy/15">
  <div class="mx-auto max-w-6xl px-5 lg:px-8" data-reveal>
    <div class="grid lg:grid-cols-12 gap-8 lg:items-end">
      <div class="lg:col-span-7">
        <p class="text-[0.7rem] font-bold uppercase tracking-[0.32em] text-brand-navy/70 border-l-4 border-brand-yellow pl-3">
          No. 05 — Where We Serve
        </p>
        <h2 class="mt-5 font-condensed font-bold uppercase text-5xl sm:text-6xl lg:text-7xl leading-[0.9] text-brand-navy">
          Miami-Dade<br />and Broward.
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-base text-brand-ink/85 font-serif leading-relaxed border-l-2 border-brand-navy/20 pl-5">
          Walk in, call, or have it delivered — depending on the order, we cover most of the metro from our shop in Hialeah.
        </p>
      </div>
    </div>

    <div class="mt-14 grid lg:grid-cols-12 gap-10 items-start">
      <!-- Alphabetical index -->
      <div class="lg:col-span-4">
        <p class="text-[0.65rem] uppercase tracking-[0.22em] text-brand-navy/60 font-bold mb-4 border-b border-brand-navy/20 pb-3">
          Index of locations
        </p>
        <ul class="divide-y divide-brand-navy/15">
          {serviceCities.map((c) => (
            <li>
              <a
                href={`/service-area/${c.toLowerCase().replace(/\s+/g, "-")}`}
                class="flex items-center justify-between py-3 group"
              >
                <span class="font-condensed font-bold uppercase text-lg text-brand-navy tracking-[0.02em] group-hover:text-brand-yellow transition-colors">
                  {c}
                </span>
                <Icon name="arrow-right" size={14} strokeWidth={2} class="text-brand-navy/40 group-hover:text-brand-yellow transition-colors" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Map -->
      <div class="lg:col-span-8">
        <div class="relative ring-1 ring-brand-navy/15">
          <ServiceMap ratio="16/11" />
          <div class="absolute top-0 inset-x-0 bg-brand-navy text-white px-4 py-2 flex items-center justify-between text-[0.65rem] uppercase tracking-[0.22em] pointer-events-none font-bold">
            <span class="inline-flex items-center gap-2">
              <Icon name="map-pin" size={12} strokeWidth={2.25} class="text-brand-yellow" />
              151 E 10th Ave · Hialeah
            </span>
            <span class="hidden sm:inline text-brand-yellow">Fig. 02 — Location</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
