---
import PhotoPlaceholder from "../../PhotoPlaceholder.astro";
import Icon from "../../Icon.astro";
---

<section class="bg-white border-b border-brand-navy/15">
  <div class="mx-auto max-w-7xl">
    <div class="relative">
      <PhotoPlaceholder
        label="Wide shop photo — parts shelves, counter, or storefront exterior"
        ratio="21/9"
        recommended="2400×1029 JPG"
        class="!rounded-none"
      />
      <!-- Overlay tag, magazine-style -->
      <div class="absolute bottom-6 left-6 lg:bottom-10 lg:left-10 max-w-md bg-brand-cream border-l-4 border-brand-yellow p-5 lg:p-6" data-reveal>
        <p class="text-[0.65rem] uppercase tracking-[0.22em] text-brand-navy/60 font-bold">Photo essay · Inside the shop</p>
        <h3 class="mt-2 font-condensed font-bold uppercase text-2xl lg:text-3xl text-brand-navy leading-tight">
          One shop. One team. Years of parts.
        </h3>
        <p class="mt-3 text-sm text-brand-ink/80 font-serif leading-relaxed">
          151 E 10th Ave, Hialeah. No franchise, no call center, no markup games. Just the people who know where the deals actually are.
        </p>
        <a
          href="/about"
          class="mt-4 inline-flex items-center gap-1 text-xs uppercase tracking-[0.18em] font-bold text-brand-navy border-b-2 border-brand-yellow hover:border-brand-navy transition-colors"
        >
          Read the story
          <Icon name="arrow-right" size={14} strokeWidth={2.25} />
        </a>
      </div>
    </div>
  </div>
</section>
