---
import Icon from "../Icon.astro";
import { business } from "../../data/content.ts";
---

<header class="sticky top-0 z-30 bg-brand-cream text-brand-navy border-b border-brand-navy/15">
  <!-- Masthead top rule -->
  <div class="border-b border-brand-navy/15">
    <div class="mx-auto max-w-6xl px-5 lg:px-8 h-7 flex items-center justify-between text-[0.65rem] uppercase tracking-[0.22em] text-brand-navy/60">
      <span>Mory's · Hialeah, FL · Est. South Florida</span>
      <span class="hidden sm:inline">Edition 01 · Auto Parts &amp; Glass</span>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3" aria-label={`${business.name} — home`}>
      <img
        src="/morys_logo.png"
        alt=""
        width="44"
        height="44"
        class="w-11 h-11 object-contain"
      />
      <div class="leading-none">
        <span class="block font-condensed text-2xl tracking-[0.04em] text-brand-navy font-bold uppercase">Mory's</span>
        <span class="block mt-1 text-[0.62rem] uppercase tracking-[0.28em] text-brand-navy/70 font-semibold">Auto Parts &amp; Glass</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-[0.72rem] font-semibold uppercase tracking-[0.18em]">
      <a href="/" class="text-brand-navy hover:text-brand-yellow transition-colors">Home</a>
      <a href="/about" class="text-brand-navy hover:text-brand-yellow transition-colors">About</a>
      <a href="/service-area" class="text-brand-navy hover:text-brand-yellow transition-colors">Service Area</a>
      <a href="/contact" class="text-brand-navy hover:text-brand-yellow transition-colors">Contact</a>
    </nav>

    <a
      href={business.phoneHref}
      class="hidden sm:inline-flex items-center gap-2 border-2 border-brand-navy text-brand-navy font-bold px-4 py-2 hover:bg-brand-yellow hover:border-brand-yellow transition-colors"
    >
      <Icon name="phone" size={15} strokeWidth={2.25} />
      <span class="text-sm">{business.phone}</span>
    </a>

    <button
      id="mobile-menu-btn-ed"
      class="md:hidden text-brand-navy p-2 -mr-2"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <Icon name="menu" size={24} strokeWidth={2} />
    </button>
  </div>

  <div id="mobile-menu-ed" class="hidden md:hidden bg-brand-cream border-t border-brand-navy/15">
    <nav class="px-5 py-4 flex flex-col gap-1 text-base font-semibold uppercase tracking-[0.15em]">
      <a href="/" class="py-3 border-b border-brand-navy/10 text-brand-navy">Home</a>
      <a href="/about" class="py-3 border-b border-brand-navy/10 text-brand-navy">About</a>
      <a href="/service-area" class="py-3 border-b border-brand-navy/10 text-brand-navy">Service Area</a>
      <a href="/contact" class="py-3 border-b border-brand-navy/10 text-brand-navy">Contact</a>
      <a href={business.phoneHref} class="mt-3 inline-flex items-center justify-center gap-2 bg-brand-yellow text-brand-navy px-4 py-3 font-bold">
        <Icon name="phone" size={18} strokeWidth={2.25} />
        Call {business.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn-ed");
  const menu = document.getElementById("mobile-menu-ed");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
