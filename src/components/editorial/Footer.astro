---
import Icon from "../Icon.astro";
import { business } from "../../data/content.ts";
---

<footer class="bg-brand-cream text-brand-ink border-t border-brand-navy/15">
  <div class="mx-auto max-w-6xl px-5 lg:px-8 py-14 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <div class="flex items-center gap-3">
        <img src="/morys_logo.png" alt="" width="48" height="48" class="w-12 h-12 object-contain" />
        <p class="font-condensed text-3xl uppercase tracking-[0.04em] font-bold text-brand-navy">Mory's Auto Parts &amp; Glass</p>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-brand-ink/75 max-w-sm font-serif">
        New, used, and aftermarket parts for South Florida. Direct pricing, hard-to-find sourcing, bilingual service.
      </p>
      <div class="mt-5 border-t border-brand-navy/20 pt-4 text-[0.65rem] uppercase tracking-[0.22em] text-brand-navy/60">
        Edition 01 · Established South Florida
      </div>
    </div>

    <div class="md:col-span-3">
      <p class="text-[0.7rem] uppercase tracking-[0.22em] text-brand-navy font-bold border-b border-brand-navy/20 pb-2">Visit</p>
      <p class="mt-3 text-sm leading-relaxed text-brand-ink/80 font-serif">
        {business.address.line1}<br />
        {business.address.line2}
      </p>
      <p class="mt-3 text-sm text-brand-ink/80 inline-flex items-center gap-2">
        <Icon name="clock" size={14} strokeWidth={2} />
        {business.hours}
      </p>
    </div>

    <div class="md:col-span-4">
      <p class="text-[0.7rem] uppercase tracking-[0.22em] text-brand-navy font-bold border-b border-brand-navy/20 pb-2">Contact</p>
      <a href={business.phoneHref} class="mt-3 inline-flex items-center gap-2 text-base font-bold text-brand-navy hover:text-brand-yellow transition-colors">
        <Icon name="phone" size={15} strokeWidth={2} />
        {business.phone}
      </a>
      <a href={`mailto:${business.email}`} class="mt-1 inline-flex items-center gap-2 text-sm text-brand-ink/80 hover:text-brand-yellow transition-colors">
        <Icon name="mail" size={14} strokeWidth={2} />
        {business.email}
      </a>
    </div>
  </div>

  <div class="border-t border-brand-navy/20">
    <div class="mx-auto max-w-6xl px-5 lg:px-8 py-4 flex flex-col md:flex-row gap-3 items-start md:items-center justify-between text-[0.7rem] uppercase tracking-[0.18em] text-brand-ink/55">
      <p>© {new Date().getFullYear()} Mory's Auto Parts &amp; Glass · Hialeah, FL</p>
      <div class="flex items-center gap-5">
        <a href="/admin" class="hover:text-brand-navy" rel="nofollow">Staff</a>
      </div>
    </div>
  </div>
</footer>
